<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Deep premium gaming dark background -->
    <path
        android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#210000" /> <!-- Deep royal red tone -->
                <item android:offset="0.4" android:color="#0B0B0B" /> <!-- Slate charcoal black -->
                <item android:offset="1.0" android:color="#1F1500" /> <!-- Gold dark ambiance shadow -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center radial glowing gaming aura -->
    <path
        android:pathData="M14,14h80v80h-80z"
        android:fillAlpha="0.25">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="45"
                android:type="radial">
                <item android:offset="0.0" android:color="#FF1E1E" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing golden border frame representing Rajasthan royalty -->
    <path
        android:pathData="M18,18 h72 v72 h-72 z"
        android:strokeColor="#FFB800"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.6"
        android:fillColor="#00000000" />

    <!-- Secondary outer dark red gaming framing -->
    <path
        android:pathData="M12,12 h84 v84 h-84 z"
        android:strokeColor="#FF1E1E"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.4"
        android:fillColor="#00000000" />
</vector>
